<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principal de l'activité.
    Remplace la BottomNavigationView par une top-bar fixe avec :
      • Logo "MG4Control"
      • Indicateur firmware read-only (chip SWI133 / chip SWI68)
      • Onglets, dans l'ordre : PROFILS, AUTOMATISATION, RACCOURCIS, STATISTIQUES, RÉGLAGES
    La zone de contenu en dessous est gérée par le NavController.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:orientation="horizontal">

    <!-- ── TOP BAR ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/dash_card"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Logo image -->


        <!-- Bouton PROFILS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_profiles"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/orbitron_black"
            android:foregroundTint="#E91E63"
            android:letterSpacing="0.07"
            android:rotationX="-4"
            android:text="@string/nav_profiles"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:backgroundTint="@color/dash_btn"
            app:cornerRadius="8dp"
            app:strokeColor="@color/dash_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_automation"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/orbitron_black"
            android:letterSpacing="0.06"
            android:text="@string/nav_automation"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:backgroundTint="@color/dash_btn"
            app:cornerRadius="8dp"
            app:strokeColor="@color/dash_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_shortcuts"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/orbitron_black"

            android:letterSpacing="0.06"
            android:text="@string/nav_shortcuts"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:backgroundTint="@color/dash_btn"
            app:cornerRadius="8dp"
            app:strokeColor="@color/dash_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_stats"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/orbitron_black"
            android:letterSpacing="0.06"
            android:text="@string/nav_stats"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:backgroundTint="@color/dash_btn"
            app:cornerRadius="8dp"
            app:strokeColor="@color/dash_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_nav_settings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"

            android:fontFamily="@font/orbitron_black"
            android:letterSpacing="0.06"
            android:text="@string/nav_settings"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:backgroundTint="@color/dash_btn"
            app:cornerRadius="8dp"
            app:strokeColor="@color/dash_border"
            app:strokeWidth="1dp" />

        <ImageView
            android:id="@+id/topbar_logo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="@integer/material_motion_duration_short_2"
            android:adjustViewBounds="true"
            android:background="@drawable/gradient_logo_bg"
            android:contentDescription="@string/app_name"
            android:scaleType="fitStart"
            android:src="@drawable/logo_topbar" />

        <!-- Bouton AUTOMATISATION -->

        <!-- Bouton RACCOURCIS -->

        <!-- Bouton STATISTIQUES -->

        <!-- Bouton RÉGLAGES -->

    </LinearLayout>

    <!-- ── ZONE DE CONTENU (NavController) ────────────────────────── -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

</LinearLayout>
